# Modem Family Driver Makefile
# Copyright (c) 2025 NUX Project

include @top_srcdir@/mk/top.mk

LIB = iokit_modem

SRCS = \
	sources/modem.c

INCS = \
	include/modem.h

INCDIR = $(includedir)/iokit/families/modem

CFLAGS += -I$(top_srcdir)/nux/libs/iokit/include/public
CFLAGS += -I$(top_srcdir)/nux/libs/iokit/families/modem/include
CFLAGS += -I$(top_srcdir)/nux/libs/iokit/families/serial/include
CFLAGS += -I$(top_srcdir)/ananke/include
CFLAGS += -I$(top_srcdir)/include

# Modem family depends on serial family for UART communication
LDFLAGS += -L$(top_srcdir)/nux/libs/iokit/families/serial -liokit_serial

include @top_srcdir@/mk/lib.mk
include @top_srcdir@/mk/bottom.mk
