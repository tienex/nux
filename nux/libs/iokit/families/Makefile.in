# IOKit Families Makefile
# Copyright (c) 2025 NUX Project

include @top_srcdir@/mk/top.mk

# Build order with dependencies:
# 1. Platform firmware (platform - device enumeration)
# 2. Core abstractions (bus, storage)
# 3. System infrastructure (timer, power)
# 4. Modern buses (pcie, usb, firewire, isa)
# 5. Legacy buses (nubus, zorro, sbus, turbochannel, mca, vmebus, unibus, qbus, cbus, s100)
# 6. Storage protocols (nvme, sata, scsi)
# 7. High-speed interconnects (thunderbolt, rdma)
# 8. Low-level buses (i2c, spi, hid)
# 9. Multimedia (display, audio, network)
# 10. Security (crypto)
# 11. Virtualization (virt)

SUBDIRS = platform bus storage timer power \
          pcie usb firewire isa \
          nubus zorro sbus turbochannel mca vmebus unibus qbus cbus s100 \
          nvme sata scsi thunderbolt rdma \
          i2c spi hid \
          display audio network \
          crypto virt

# Dependency declarations
platform:

bus:

storage:

pcie:

usb: pcie

firewire: pcie

isa:

# Legacy bus families (no dependencies)
nubus:

zorro:

sbus:

turbochannel:

mca:

vmebus:

unibus:

qbus:

cbus:

s100:

i2c:

spi:

hid:

nvme: pcie storage

sata: pcie storage

scsi: pcie storage

thunderbolt: pcie

rdma: pcie

virt: pcie

network:

timer:

power:

display: pcie

audio: pcie

crypto:

include @top_srcdir@/mk/subdir.mk
include @top_srcdir@/mk/bottom.mk
