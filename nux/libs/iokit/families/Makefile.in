# IOKit Families Makefile
# Copyright (c) 2025 NUX Project

include @top_srcdir@/mk/top.mk

# Build order with dependencies:
# 1. Platform firmware (platform - device enumeration)
# 2. Core abstractions (bus, storage)
# 3. System infrastructure (timer, power)
# 4. Base buses (pcie, usb, firewire, isa)
# 5. Storage protocols (nvme, sata, scsi)
# 6. High-speed interconnects (thunderbolt, rdma)
# 7. Low-level buses (i2c, spi, hid)
# 8. Multimedia (display, audio, network)
# 9. Security (crypto)
# 10. Virtualization (virt)

SUBDIRS = platform bus storage timer power pcie usb firewire isa i2c spi hid nvme sata scsi thunderbolt rdma display audio network crypto virt

# Dependency declarations
platform:

bus:

storage:

pcie:

usb: pcie

firewire: pcie

isa:

i2c:

spi:

hid:

nvme: pcie storage

sata: pcie storage

scsi: pcie storage

thunderbolt: pcie

rdma: pcie

virt: pcie

network:

timer:

power:

display: pcie

audio: pcie

crypto:

include @top_srcdir@/mk/subdir.mk
include @top_srcdir@/mk/bottom.mk
