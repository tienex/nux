# IOKit Families Makefile
# Copyright (c) 2025 NUX Project

include @top_srcdir@/mk/top.mk

# Build order with dependencies:
# 1. Core abstractions (bus, storage)
# 2. Base buses (pcie, usb, firewire)
# 3. Storage protocols (nvme, sata, scsi)
# 4. High-speed interconnects (thunderbolt, rdma)
# 5. Low-level buses (i2c, spi, hid)
# 6. Virtualization (virt)

SUBDIRS = bus storage pcie usb firewire isa i2c spi hid nvme sata scsi thunderbolt rdma virt network

# Dependency declarations
bus:

storage:

pcie:

usb: pcie

firewire: pcie

isa:

i2c:

spi:

hid:

nvme: pcie storage

sata: pcie storage

scsi: pcie storage

thunderbolt: pcie

rdma: pcie

virt: pcie

network:

include @top_srcdir@/mk/subdir.mk
include @top_srcdir@/mk/bottom.mk
