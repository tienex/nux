# SBus Family Driver Makefile
# Copyright (c) 2025 NUX Project

include @top_srcdir@/mk/top.mk

LIB = iokit_sbus

SRCS = \
	sources/sbus.c

INCS = \
	include/sbus.h

INCDIR = $(includedir)/iokit/families/sbus

CFLAGS += -I$(top_srcdir)/nux/libs/iokit/include/public
CFLAGS += -I$(top_srcdir)/nux/libs/iokit/families/sbus/include
CFLAGS += -I$(top_srcdir)/ananke/include
CFLAGS += -I$(top_srcdir)/include

include @top_srcdir@/mk/lib.mk
include @top_srcdir@/mk/bottom.mk
