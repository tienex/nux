NUXSRCROOT=@NUXSRCROOT@
NUXBUILDROOT=@NUXBUILDROOT@
NUXSRCDIR=@LIBNUX_SRCDIR@
NUXBUILDDIR=@LIBNUX_BUILDDIR@

include @LIBNUX_BUILDDIR@/cfg.mk
include @NUXBUILDROOT@/libs/hal/hal.mk
include @NUXBUILDROOT@/libs/platform/plt.mk

CPPFLAGS+= -I@NUXSRCROOT@/libs/nux/include/public/nux -I@NUXSRCROOT@/libs/hal/include/public/hal -I@NUXSRCROOT@/libs/platform/include/public/platform -I@NUXSRCROOT@/apxh/include/public/apxh -I@NUXSRCROOT@/libs/hal/include/private/hal -I@NUXSRCROOT@/libs/platform/include/private/platform -I@NUXSRCROOT@/libs/nux/include/private/nux
LDFLAGS+= -fno-omit-frame-pointer
