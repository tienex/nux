include @LIBNUX_BUILDDIR@/cfg.mk

@COMPILE_LIBNUX@

LINKERSCRIPT+= @NUXSRCROOT@/libs/hal/$(LDFILE)
LDFLAGS+= -L@NUXBUILDROOT@/libs/hal/$(OBJDIR) -L@LIBNUX_BUILDDIR@/$(OBJDIR) -L@NUXBUILDROOT@/libs/platform/$(OBJDIR)
LDADD+=-lhal -lplt -lnux -u _nux_sysinit

LIBDEPS+= @NUXBUILDROOT@/libs/nux/$(OBJDIR)/libnux.a @NUXBUILDROOT@/libs/hal/$(OBJDIR)/libhal.a @NUXBUILDROOT@/libs/platform/$(OBJDIR)/libplt.a
