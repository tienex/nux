HOST_CC=@CC@

vpath %.c $(SRCDIR)

ar50: ar50.c squoze.c
	$(HOST_CC) $^ -o $@ $(CFLAGS) $(LDFLAGS)

ar64: ar64.c zoo64.c bwt.c mtf.c lz78.c range.c compress.c
	$(HOST_CC) $^ -o $@ $(CFLAGS) $(LDFLAGS)

sq: sq.c squoze.c
	$(HOST_CC) $^ -o $@ $(CFLAGS) $(LDFLAGS)

unsq: unsq.c squoze.c
	$(HOST_CC) $^ -o $@ $(CFLAGS) $(LDFLAGS)

.PHONY: clean
clean:
	rm -f *.o ar50 ar64 sq unsq

ALL_TARGET += ar50 ar64 sq unsq
CLEAN_TARGET += clean
