ASFLAGS=-m32
#-fno-delete-null-pointer-checks because 0 is a valid address.
CFLAGS+= -I$(SRCDIR)../src/ -I$(SRCROOT)/include -I$(BUILDROOT)/include -fno-delete-null-pointer-checks
LDFLAGS+= -T$(SRCDIR)/multiboot.ld
LDADD_START+= crt0.o

PROGRAM=apxh
SRCS+= ../src/main.c ../src/elf.c ../src/payload.c
SRCS+= ../src/pae_common.c ../src/pae32.c ../src/pae64.c ../src/split.c
SRCS+= console.c platform.c rsdp.c mps.c


CC=@TOOLCHAIN_32@-gcc

EC_MACHINE=i386

@COMPILE_LIBEC@
@LINK_LIBEC@

ALL_TARGET+= crt0.o
CLEAN_FILES+= crt0.o
