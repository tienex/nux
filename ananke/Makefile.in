# This Makefile builds the ANANKE NT RTL library
# It can be built for different architectures as needed

LIBDIR=lib
LIBRARY=ananke

# NT RTL sources (architecture-independent)
SRCS = sources/ntrtl/memory.c \
       sources/ntrtl/string.c \
       sources/ntrtl/list.c \
       sources/ntrtl/bitmap.c \
       sources/ntrtl/tree.c \
       sources/ntrtl/utility.c

# Framebuffer library sources
SRCS += libs/framebuffer/sources/dither.c \
        libs/framebuffer/sources/pixelformat.c \
        libs/framebuffer/sources/bidi.c \
        libs/framebuffer/sources/font.c \
        libs/framebuffer/sources/text.c \
        libs/framebuffer/sources/palette.c \
        libs/framebuffer/sources/factory.c \
        libs/framebuffer/sources/backends/generic.c \
        libs/framebuffer/sources/backends/hercules.c \
        libs/framebuffer/sources/backends/vga16.c \
        libs/framebuffer/sources/backends/vesa_linear.c \
        libs/framebuffer/sources/backends/vesa_banked.c \
        libs/framebuffer/sources/backends/uefi_gop.c \
        libs/framebuffer/sources/backends/apple_efi.c \
        libs/framebuffer/sources/fonts/8x8.c \
        libs/framebuffer/sources/fonts/8x14.c \
        libs/framebuffer/sources/fonts/8x16.c \
        libs/framebuffer/sources/fonts/scrawl.c

# D3D common infrastructure (shared by D3D3-D3D9)
SRCS += libs/d3d_common/sources/ffp_generator.c \
        libs/d3d_common/sources/fvf_parser.c \
        libs/d3d_common/sources/utilities.c

# D3D9 library sources
SRCS += libs/d3d9/sources/gles20com/gldevice.c \
        libs/d3d9/sources/d3d9/d3d9main.c \
        libs/d3d9/sources/d3d9/resources.c \
        libs/d3d9/sources/d3d9/shader.c \
        libs/d3d9/sources/d3d9/statemanager.c \
        libs/d3d9/sources/d3d9/vertexbinding.c \
        libs/d3d9/sources/d3d9/shaderconstants.c \
        libs/d3d9/sources/d3d9/shadertranslator.c

# D3D8 library sources
SRCS += libs/d3d8/sources/d3d8/d3d8main.c

# D3D7 library sources
SRCS += libs/d3d7/sources/d3d7/d3d7main.c

# D3D6 library sources
SRCS += libs/d3d6/sources/d3d6/d3d6main.c

# D3D5 library sources
SRCS += libs/d3d5/sources/d3d5/d3d5main.c

# D3D3 library sources
SRCS += libs/d3d3/sources/d3d3/d3d3main.c

# Include directories
CFLAGS += -I$(SRCDIR)/include
CFLAGS += -I$(SRCDIR)/libs/framebuffer/include
CFLAGS += -I$(SRCDIR)/libs/d3d_common/include
CFLAGS += -I$(SRCDIR)/libs/d3d3/include
CFLAGS += -I$(SRCDIR)/libs/d3d5/include
CFLAGS += -I$(SRCDIR)/libs/d3d6/include
CFLAGS += -I$(SRCDIR)/libs/d3d7/include
CFLAGS += -I$(SRCDIR)/libs/d3d8/include
CFLAGS += -I$(SRCDIR)/libs/d3d9/include
CFLAGS += -I$(SRCDIR)/contrib/libs/gles20/public

# Headers to install
INCDIR=include/ananke
INCS += $(wildcard include/ananke/*.h)
INCS += $(wildcard include/ananke/ntrtl/*.h)
INCS += $(wildcard libs/framebuffer/include/ananke/*.h)
INCS += $(wildcard libs/framebuffer/include/ananke/framebuffer/*.h)
INCS += $(wildcard libs/d3d_common/include/ananke/*.h)
INCS += $(wildcard libs/d3d3/include/ananke/*.h)
INCS += $(wildcard libs/d3d5/include/ananke/*.h)
INCS += $(wildcard libs/d3d6/include/ananke/*.h)
INCS += $(wildcard libs/d3d7/include/ananke/*.h)
INCS += $(wildcard libs/d3d8/include/ananke/*.h)
INCS += $(wildcard libs/d3d9/include/ananke/*.h)
