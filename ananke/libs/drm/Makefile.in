LIBDIR=drm
LIBRARY=drm

# Source files
SRCS  = sources/drm_device.c
SRCS += sources/drm_api.c

# Include directories
CFLAGS += -I$(SRCDIR)/include
CFLAGS += -I$(TOPDIR)/ananke/include
CFLAGS += -I$(TOPDIR)/ananke/libs/framebuffer/include

# Headers to install
INCDIR=ananke
INCS += $(wildcard include/ananke/*.h)
INCS += $(wildcard include/ananke/drm/*.h)

include $(TOPDIR)/build/Rules.mk
