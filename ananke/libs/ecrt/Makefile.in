	assert.h \
	cdefs.h \
	cdefs_elf.h \
	ctype.h \
	errno.h \
	inttypes.h \
	limits.h \
	ntrtl_compat.h \
	queue.h \
	rbtree.h \
	setjmp.h \
	stdarg.h \
	stdbool.h \
	stddef.h \
	stdint.h \
	stdio.h \
	stdlib.h \
	string.h
