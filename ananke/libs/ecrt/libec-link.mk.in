##
#
# To embed libecrt in your target, include this file.
# $(ECRT_SRCS) will be added to your sources.
#

ifeq (z$(ECRT_MACHINE),z)
ECRT_MACHINE=@MACHINE@
endif

ECRT_DIR=@LIBECRT_SRCDIR@
ECRT_ARCH_DIR= $(ECRT_MACHINE)

include $(ECRT_DIR)/ec_sources.mk

LDADD_START+= $(OBJDIR)/crti.o $(OBJDIR)/crtbegin.o
LDADD_END+= $(OBJDIR)/crtn.o $(OBJDIR)/crtend.o

vpath %.c $(dir $(addprefix $(ECRT_DIR)/,$(ECRT_SRCS))) $(ECRT_DIR)
vpath %.S $(dir $(addprefix $(ECRT_DIR)/,$(ECRT_SRCS))) $(ECRT_DIR)
SRCS+= $(ECRT_SRCS)

OBJSRCS+= crti.S crtn.S crtbegin.S crtend.S

