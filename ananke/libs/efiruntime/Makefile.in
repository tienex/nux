LIBDIR=efiruntime
LIBRARY=efiruntime

# Source files
SRCS  = sources/efiruntime.c

# Include directories
CFLAGS += -I$(SRCDIR)/include
CFLAGS += -I$(TOPDIR)/ananke/include
CFLAGS += -I$(TOPDIR)/ananke/libs/ecrt/include/public

# Headers to install
INCDIR=ananke
INCS += $(wildcard include/ananke/*.h)

include $(TOPDIR)/build/Rules.mk
