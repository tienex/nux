LIBDIR=framebuffer
LIBRARY=framebuffer

# Source files
SRCS  = sources/dither.c
SRCS += sources/pixelformat.c
SRCS += sources/bidi.c
SRCS += sources/font.c
SRCS += sources/text.c
SRCS += sources/palette.c
SRCS += sources/backends/generic.c

# Font data
SRCS += sources/fonts/8x8.c
SRCS += sources/fonts/8x14.c
SRCS += sources/fonts/8x16.c
SRCS += sources/fonts/scrawl.c

# Include directories
CFLAGS += -I$(SRCDIR)/include
CFLAGS += -I$(TOPDIR)/ananke/include

# Headers to install
INCDIR=ananke
INCS += $(wildcard include/ananke/*.h)
INCS += $(wildcard include/ananke/framebuffer/*.h)

include $(TOPDIR)/build/Rules.mk
