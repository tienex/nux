@PACKAGE_INIT@

# Ananke CMake Package Configuration File

include("${CMAKE_CURRENT_LIST_DIR}/AnankeTargets.cmake")

check_required_components(Ananke)

# Provide variables for downstream projects
set(ANANKE_VERSION "@PROJECT_VERSION@")
set(ANANKE_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

# Set found flag
set(Ananke_FOUND TRUE)
